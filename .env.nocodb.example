# PostgreSQL Configuration
POSTGRES_DB=nocodb
POSTGRES_USER=nocodb
POSTGRES_PASSWORD=nocodb_secure_password_2024

# NocoDB Configuration
NC_AUTH_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NC_PUBLIC_URL=http://72.60.51.124:8080

# Admin Credentials (First User)
NC_ADMIN_EMAIL=admin@nocodb.com
NC_ADMIN_PASSWORD=admin123

# Storage Settings
NC_ATTACHMENT_FIELD_SIZE=20971520  # 20MB
NC_MAX_ATTACHMENTS_ALLOWED=10

# Telemetry
NC_DISABLE_TELE=true

# Email Authentication
NC_DISABLE_EMAIL_AUTH=false

# Optional: SMTP Configuration
# NC_SMTP_FROM=noreply@yourdomain.com
# NC_SMTP_HOST=smtp.gmail.com
# NC_SMTP_PORT=587
# NC_SMTP_USERNAME=your-email@gmail.com
# NC_SMTP_PASSWORD=your-app-password
# NC_SMTP_SECURE=true

# Optional: S3 Storage Configuration
# NC_S3_BUCKET_NAME=your-bucket-name
# NC_S3_REGION=us-east-1
# NC_S3_ACCESS_KEY=your-access-key
# NC_S3_ACCESS_SECRET=your-secret-key
