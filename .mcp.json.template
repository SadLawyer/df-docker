{
  "mcpServers": {
    "docker-mcp": {
      "type": "http",
      "url": "http://YOUR_REMOTE_HOST:3002",
      "headers": {
        "Authorization": "Basic YOUR_BASE64_ENCODED_CREDENTIALS",
        "Content-Type": "application/json"
      }
    },
    "filesystem-mcp": {
      "type": "http",
      "url": "http://YOUR_REMOTE_HOST:3003",
      "headers": {
        "Authorization": "Basic YOUR_BASE64_ENCODED_CREDENTIALS",
        "Content-Type": "application/json"
      }
    },
    "fetch-mcp": {
      "type": "http",
      "url": "http://localhost:3004",
      "headers": {
        "Authorization": "Basic YOUR_BASE64_ENCODED_CREDENTIALS",
        "Content-Type": "application/json"
      },
      "comment": "Requires SSH tunnel - see MCP-SETUP.md"
    },
    "notion-mcp": {
      "type": "http",
      "url": "http://localhost:3005",
      "headers": {
        "Authorization": "Basic YOUR_BASE64_ENCODED_CREDENTIALS",
        "Content-Type": "application/json"
      },
      "comment": "Requires SSH tunnel - see MCP-SETUP.md"
    },
    "nocodb": {
      "type": "http",
      "url": "http://YOUR_REMOTE_HOST:8080/api/v1",
      "headers": {
        "xc-auth": "YOUR_NOCODB_API_TOKEN",
        "Content-Type": "application/json"
      },
      "comment": "NocoDB API - get token from NocoDB UI: Account Settings > API Tokens"
    }
  }
}
